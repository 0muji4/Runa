<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      平文 HTTP は network_security_config で release では不可、debug のみ可にしている
      （src/debug/res/xml が同名ファイルを上書きする）。バックアップは日記 DB と
      トークンを持ち出さないよう、設定ファイルだけを include する default-deny。
      dataExtractionRules が API 31+、fullBackupContent が API 30 以下に効く。
    -->
    <application
        android:name=".RunaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Runa">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Runa">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
