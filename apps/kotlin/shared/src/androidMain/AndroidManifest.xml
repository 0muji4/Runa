<?xml version="1.0" encoding="utf-8"?>
<!-- Shared-module manifest: the push-reminder service lives in shared androidMain and
     merges into the app. POST_NOTIFICATIONS is requested at runtime in onboarding (④). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="com.runa.shared.feature.push.RunaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
