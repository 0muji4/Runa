-- client_id is the device-generated primary key; server_id / object_key are null until the upload completes.
-- sync_state: synced | pending_upload | pending_delete
-- pending_bytes holds a queued upload's bytes until uploaded. Timestamps are ISO-8601 strings;
-- view_url_expires_at is epoch-millis.

CREATE TABLE gallery_images (
    client_id           TEXT NOT NULL PRIMARY KEY,
    server_id           TEXT,
    object_key          TEXT,
    width               INTEGER NOT NULL,
    height              INTEGER NOT NULL,
    view_url            TEXT,
    view_url_expires_at INTEGER,
    pending_bytes       BLOB,
    content_type        TEXT,
    created_at          TEXT NOT NULL,
    updated_at          TEXT NOT NULL,
    deleted_at          TEXT,
    sync_state          TEXT NOT NULL
);

CREATE INDEX gallery_images_created_idx ON gallery_images(created_at);

-- ---- reads ----

selectVisible:
SELECT *
FROM gallery_images
WHERE deleted_at IS NULL
ORDER BY created_at DESC;

selectByClientId:
SELECT *
FROM gallery_images
WHERE client_id = ?;

selectByServerId:
SELECT *
FROM gallery_images
WHERE server_id = ?;

-- Oldest first so uploads replay in the order they were added.
selectPending:
SELECT *
FROM gallery_images
WHERE sync_state != 'synced'
ORDER BY created_at ASC;

-- Reconciled against the server list: an image absent from the server is dropped locally.
selectSynced:
SELECT *
FROM gallery_images
WHERE sync_state = 'synced' AND deleted_at IS NULL;

selectAll:
SELECT *
FROM gallery_images;

-- ---- local mutations ----

insertPendingUpload:
INSERT INTO gallery_images(client_id, server_id, object_key, width, height, view_url, view_url_expires_at, pending_bytes, content_type, created_at, updated_at, deleted_at, sync_state)
VALUES (?, NULL, NULL, ?, ?, NULL, NULL, ?, ?, ?, ?, NULL, 'pending_upload');

markUploaded:
UPDATE gallery_images
SET server_id = ?, object_key = ?, view_url = ?, view_url_expires_at = ?, pending_bytes = NULL, updated_at = ?, sync_state = 'synced'
WHERE client_id = ?;

updateViewUrl:
UPDATE gallery_images
SET view_url = ?, view_url_expires_at = ?
WHERE client_id = ?;

markPendingDelete:
UPDATE gallery_images
SET deleted_at = ?, updated_at = ?, sync_state = 'pending_delete'
WHERE client_id = ?;

deleteByClientId:
DELETE FROM gallery_images
WHERE client_id = ?;

deleteAllImages:
DELETE FROM gallery_images;

-- ---- sync application ----

-- Pull: server wins. client_id is reused for a known row, freshly generated for one first seen from the server.
applyServerRow:
INSERT OR REPLACE INTO gallery_images(client_id, server_id, object_key, width, height, view_url, view_url_expires_at, pending_bytes, content_type, created_at, updated_at, deleted_at, sync_state)
VALUES (?, ?, ?, ?, ?, ?, ?, NULL, NULL, ?, ?, NULL, 'synced');
